{
  "info": {
    "_postman_id": "logistica-ms-encomiendas",
    "name": "logistica-ms",
    "description": "Pruebas de vehículos, rutas y asignaciones del microservicio logistica-ms (puerto 8081).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" },
    { "key": "vehiculoId", "value": "1" },
    { "key": "rutaId", "value": "1" },
    { "key": "pedidoId", "value": "1" },
    { "key": "conductorId", "value": "1" }
  ],
  "item": [
    {
      "name": "crearVehiculo",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"patente\": \"ABCD12\",\n  \"capacidadKg\": 500\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/v1/vehiculos", "host": ["{{baseUrl}}"], "path": ["api", "v1", "vehiculos"] }
      }
    },
    {
      "name": "verVehiculos",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/v1/vehiculos", "host": ["{{baseUrl}}"], "path": ["api", "v1", "vehiculos"] }
      }
    },
    {
      "name": "actualizarVehiculos",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"estado\": \"EN_MANTENCION\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/v1/vehiculos/{{vehiculoId}}/estado", "host": ["{{baseUrl}}"], "path": ["api", "v1", "vehiculos", "{{vehiculoId}}", "estado"] }
      }
    },
    {
      "name": "crearRuta",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Centro - Providencia\",\n  \"comunaId\": 1\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/v1/rutas", "host": ["{{baseUrl}}"], "path": ["api", "v1", "rutas"] }
      }
    },
    {
      "name": "listarRutas",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/v1/rutas", "host": ["{{baseUrl}}"], "path": ["api", "v1", "rutas"] }
      }
    },
    {
      "name": "asignarRuta",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pedidoId\": {{pedidoId}},\n  \"vehiculoId\": {{vehiculoId}},\n  \"rutaId\": {{rutaId}},\n  \"conductorId\": {{conductorId}},\n  \"pesoKg\": 100\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/v1/asignaciones", "host": ["{{baseUrl}}"], "path": ["api", "v1", "asignaciones"] }
      }
    },
    {
      "name": "asignarRuta 409 (repetida)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pedidoId\": {{pedidoId}},\n  \"vehiculoId\": {{vehiculoId}},\n  \"rutaId\": {{rutaId}},\n  \"conductorId\": {{conductorId}},\n  \"pesoKg\": 100\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/v1/asignaciones", "host": ["{{baseUrl}}"], "path": ["api", "v1", "asignaciones"] }
      }
    }
  ]
}
